{
  "name": "astra-discord-bot",
  "version": "1.0.0",
  "description": "Bot de parcerias, blacklist, contador e painel para Discord.",
  "main": "index.js",
  "type": "commonjs",
  "scripts": {
    "start": "node index.js",
    "shard": "node src/shards.js",
    "deploy": "node src/deployCommands.js",
    "showcase": "node scripts/sendCommandShowcase.js",
    "clear:global": "node src/deployCommands.js --clear-global",
    "check": "node --check index.js && find src -name '*.js' -print0 | xargs -0 -n1 node --check"
  },
  "dependencies": {
    "discord.js": "^14.15.3",
    "dotenv": "^16.4.5",
    "ioredis": "^6.0.0",
    "mongodb": "^6.8.0",
    "pino": "^10.3.1",
    "prom-client": "^15.1.3"
  },
  "engines": {
    "node": ">=18.17"
  }
}
